# Base URL of the PredictX Laravel API.
# Server-only: the browser never sees this, it talks to /api/bff/* instead.
PREDICTX_API_URL=http://localhost:8000/api

# Sent as `device_name` when minting Sanctum tokens.
PREDICTX_DEVICE_NAME=predictx-web

# Set to 1 to serve canned data from the BFF instead of calling the API.
# For previews only — the UI shows a permanent "sample data" banner while on.
NEXT_PUBLIC_PREDICTX_DEMO=0
